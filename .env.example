# Website AI & Conversion Automation Platform
# Copy this file to .env.local or .env for development and production

# General Application Settings
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SQLite Database Location
DATABASE_URL=file:./data/platform.db

# Master Application Secret (used for token signing & security hash)
APP_SECRET=change-me-to-a-secure-random-32-byte-hex-string

# AI Provider Configuration
# Options: "grounded_local" (deterministic grounded engine with zero external cost), "openai", "anthropic"
AI_PROVIDER=grounded_local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# WhatsApp Business Cloud API Configuration
# Acquire these credentials from Meta for Developers: https://developers.facebook.com
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# CRM Integration Settings
# Acquire HubSpot Private App Token from HubSpot Settings > Integrations > Private Apps
HUBSPOT_ACCESS_TOKEN=
CRM_WEBHOOK_URL=

# Default Business Workspace Settings
DEFAULT_TENANT_ID=tenant_default_01
DEFAULT_TENANT_NAME="Apex Enterprise Solutions"
DEFAULT_ALLOWED_DOMAINS="localhost,127.0.0.1,app.yourdomain.com"
